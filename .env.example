# Provider 1: GLM
LLM_GLM_API_KEY=your-glm-key
LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_GLM_MODEL=glm-5.1

# Provider 2: OpenAI compatible proxy
LLM_OPENAI_API_KEY=your-openai-compatible-key
LLM_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
LLM_OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# Conversation storage limits
CONV_MAX_MESSAGES=50
CONV_TTL_SECONDS=3600
CONV_MAX_CONVERSATIONS=1000
